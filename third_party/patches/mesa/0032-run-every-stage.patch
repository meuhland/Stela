From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daniel Brooks <bass_rock@me.com>
Date: Sat, 14 Nov 2026 16:34:47 +0000
Subject: [PATCH] radv: run every stage in wave32 from GFX10 on, and report 32
 as the only subgroup size

Stela's Metal device compiles Metal's shaders, whose SIMD groups are 32
wide and whose code assumes as much. From GFX10 on, compute, pixel,
geometry-engine and ray tracing shaders run in wave32, and subgroupSize
and maxSubgroupSize say 32, so that every stage's subgroup is 32 wide
whatever its pipeline asks. Earlier cores keep wave64.
---
 src/amd/vulkan/radv_physical_device.c | 35 ++++++++++++---------------
 1 file changed, 16 insertions(+), 19 deletions(-)

diff --git a/src/amd/vulkan/radv_physical_device.c b/src/amd/vulkan/radv_physical_device.c
index e23d3755745161d1492e76d4046c9665ccde25a5..9331137c1bbeda7fa7a39d6b0da568e8efa63aeb 100644
--- a/src/amd/vulkan/radv_physical_device.c
+++ b/src/amd/vulkan/radv_physical_device.c
@@ -53,6 +53,14 @@ typedef void *drmDevicePtr;
 #define RADV_SUPPORT_CALIBRATED_TIMESTAMPS 1
 #endif
 
+/* Stela's Metal device runs every stage in wave32 from GFX10 on
+ * (radv_physical_device_try_create), so that is the only subgroup size. */
+static uint32_t
+radv_physical_device_subgroup_size(const struct radv_physical_device *pdev)
+{
+   return pdev->info.gfx_level >= GFX10 ? 32 : RADV_SUBGROUP_SIZE;
+}
+
 static bool
 radv_perf_query_supported(const struct radv_physical_device *pdev)
 {
@@ -1934,7 +1942,7 @@ radv_get_physical_device_properties(struct radv_physical_device *pdev)
       .driverID = VK_DRIVER_ID_MESA_RADV,
       .deviceLUIDValid = false, /* The LUID is for Windows. */
       .deviceNodeMask = 0,
-      .subgroupSize = RADV_SUBGROUP_SIZE,
+      .subgroupSize = radv_physical_device_subgroup_size(pdev),
       .subgroupSupportedStages =
          VK_SHADER_STAGE_ALL_GRAPHICS | VK_SHADER_STAGE_COMPUTE_BIT | taskmesh_stages | rt_stages,
       .subgroupSupportedOperations = VK_SUBGROUP_FEATURE_BASIC_BIT | VK_SUBGROUP_FEATURE_VOTE_BIT |
@@ -2019,7 +2027,7 @@ radv_get_physical_device_properties(struct radv_physical_device *pdev)
 
       /* Vulkan 1.3 */
       .minSubgroupSize = pdev->info.gfx_level >= GFX10 ? 32 : 64,
-      .maxSubgroupSize = 64,
+      .maxSubgroupSize = radv_physical_device_subgroup_size(pdev),
       .maxComputeWorkgroupSubgroups = UINT32_MAX,
       .requiredSubgroupSizeStages = pdev->info.gfx_level >= GFX10
                                        ? VK_SHADER_STAGE_COMPUTE_BIT | VK_SHADER_STAGE_FRAGMENT_BIT | taskmesh_stages
@@ -2743,23 +2751,12 @@ radv_physical_device_try_create(struct radv_instance *instance, drmDevicePtr drm
    pdev->rt_wave_size = 64;
 
    if (pdev->info.gfx_level >= GFX10) {
-      if (instance->perftest_flags & RADV_PERFTEST_CS_WAVE_32)
-         pdev->cs_wave_size = 32;
-
-      /* For pixel shaders, wave64 is recommended. */
-      if (instance->perftest_flags & RADV_PERFTEST_PS_WAVE_32)
-         pdev->ps_wave_size = 32;
-
-      if (instance->perftest_flags & RADV_PERFTEST_GE_WAVE_32)
-         pdev->ge_wave_size = 32;
-
-      /* Default to 32 on RDNA as that gives better perf due to less issues with divergence.
-       * On GFX12+, wave32 will also be required for a future dynamic VGPR allocation implementation.
-       */
-      if (radv_is_rt_wave64_enabled(instance))
-         pdev->rt_wave_size = 64;
-      else
-         pdev->rt_wave_size = 32;
+      /* Stela's Metal device runs every stage in wave32: Metal's SIMD groups
+       * are 32 wide, and its shaders assume as much. */
+      pdev->cs_wave_size = 32;
+      pdev->ps_wave_size = 32;
+      pdev->ge_wave_size = 32;
+      pdev->rt_wave_size = 32;
    }
 
    radv_probe_video_decode(pdev);
