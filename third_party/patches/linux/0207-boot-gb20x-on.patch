+++ b/drivers/gpu/drm/nouveau/nvkm/subdev/gsp/rm/r570/gsp.c
@@ -188,6 +188,56 @@ r570_gsp_set_system_info(struct nvkm_gsp *gsp)
 	return nvkm_gsp_rpc_wr(gsp, info, NVKM_GSP_RPC_REPLY_NOSEQ);
 }
 
+static int
+r570_211_gsp_set_system_info(struct nvkm_gsp *gsp)
+{
+	struct nvkm_device *device = gsp->subdev.device;
+	struct pci_dev *pdev = container_of(device, struct nvkm_device_pci, device)->pdev;
+	GspSystemInfo_r570_211 *info;
+	u32 lnk_cap = 0;
+
+	BUILD_BUG_ON(offsetof(GspSystemInfo_r570_211, hostPageSize) != 920);
+	BUILD_BUG_ON(offsetof(GspSystemInfo_r570_211, bGspNocatEnabled) != 928);
+	BUILD_BUG_ON(offsetof(GspSystemInfo_r570_211, virtualConfigBits) != 930);
+
+	if (WARN_ON(device->type == NVKM_DEVICE_TEGRA))
+		return -ENOSYS;
+
+	info = nvkm_gsp_rpc_get(gsp, NV_VGPU_MSG_FUNCTION_GSP_SET_SYSTEM_INFO, sizeof(*info));
+	if (IS_ERR(info))
+		return PTR_ERR(info);
+
+	info->gpuPhysAddr = device->func->resource_addr(device, NVKM_BAR0_PRI);
+	info->gpuPhysFbAddr = device->func->resource_addr(device, NVKM_BAR1_FB);
+	info->gpuPhysInstAddr = device->func->resource_addr(device, NVKM_BAR2_INST);
+	if (pci_resource_flags(pdev, 5) & IORESOURCE_IO)
+		info->gpuPhysIoAddr = pci_resource_start(pdev, 5);
+	info->nvDomainBusDeviceFunc = pci_dev_id(pdev);
+	info->notifyOpSharedSurfacePhysAddr = gsp->notify_op.addr;
+	info->maxUserVa = TASK_SIZE;
+	info->pciConfigMirrorBase = device->pci->func->cfg.addr;
+	info->pciConfigMirrorSize = device->pci->func->cfg.size;
+	info->PCIDeviceID = (pdev->device << 16) | pdev->vendor;
+	info->PCISubDeviceID = (pdev->subsystem_device << 16) | pdev->subsystem_vendor;
+	info->PCIRevisionID = pdev->revision;
+	info->bGpuBehindBridge = pdev->bus && pdev->bus->number != 0;
+	info->b64bBar0Supported = !!(pci_resource_flags(pdev, 0) & IORESOURCE_MEM_64);
+	r570_gsp_acpi_info(gsp, &info->acpiMethodData);
+	info->bIsPrimary = video_is_primary_device(device->dev);
+	if (pdev->pcie_cap) {
+		u32 dev_cap = 0;
+
+		if (pci_read_config_dword(pdev, pdev->pcie_cap + PCI_EXP_DEVCAP, &dev_cap) == 0)
+			info->bFlrSupported = !!(dev_cap & PCI_EXP_DEVCAP_FLR);
+		if (pci_read_config_dword(pdev, pdev->pcie_cap + PCI_EXP_LNKCAP, &lnk_cap) == 0)
+			info->pcieConfigReg.linkCap = lnk_cap;
+	}
+	info->bPreserveVideoMemoryAllocations = false;
+	info->hostPageSize = PAGE_SIZE;
+
+	return nvkm_gsp_rpc_wr(gsp, info, NVKM_GSP_RPC_REPLY_NOSEQ);
+}
