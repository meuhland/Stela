diff --git a/drivers/gpu/drm/nouveau/nvkm/subdev/gsp/gh100.c b/drivers/gpu/drm/nouveau/nvkm/subdev/gsp/gh100.c
index 93fe3a6798ead4f2aea5aa638365df088ff8f3e8..833561a55deedb7318eddd88e59de440754c0edb 100644
--- a/drivers/gpu/drm/nouveau/nvkm/subdev/gsp/gh100.c
+++ b/drivers/gpu/drm/nouveau/nvkm/subdev/gsp/gh100.c
@@ -169,6 +169,19 @@ gh100_gsp_wpr_meta_init(struct nvkm_gsp *gsp)
 	meta->frtsSize = 0x100000;
 	meta->vgaWorkspaceSize = gsp->fb.bios.vga_workspace.size;
 	meta->pmuReservedSize = gsp->rm->wpr->rsvd_size_pmu;
+
+	/*
+	 * GB20x GSP-FMC and GSP-RM require a 4 KiB CrashCat report queue in
+	 * system memory (OpenRM kgspGetCrashcatSysmemBufferSize_GB202).
+	 */
+	if (gsp->subdev.device->card_type >= GB20x) {
+		ret = nvkm_gsp_mem_ctor(gsp, GSP_PAGE_SIZE, &gsp->crashcat);
+		if (ret)
+			return ret;
+
+		meta->sysmemAddrOfCrashReportQueue = gsp->crashcat.addr;
+		meta->sizeOfCrashReportQueue = gsp->crashcat.size;
+	}
 	return 0;
 }
 
